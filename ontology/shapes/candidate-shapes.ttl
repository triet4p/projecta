@prefix projecta: <https://w3id.org/projecta/ontology/> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .

# Candidate Evidence Shapes — Sprint 2 (S2-12)
#
# SHACL shapes for v0.2 Candidate instances.
# Validates source evidence, generator metadata, verification state,
# project scope, and the cardinality of all required candidate properties.

# ============================================================================
# CandidateShape — validates proposed knowledge items
# ============================================================================

projecta:CandidateShape a sh:NodeShape ;
    sh:targetClass projecta:Candidate ;
    rdfs:label "Candidate Shape" ;
    rdfs:comment "Validates that every Candidate has complete source evidence, generator metadata, verification state, and project scope." ;

    # ── Source evidence ────────────────────────────────────────────────

    # prov:wasDerivedFrom: at least 1 link to a source NoteItem
    sh:property [
        sh:path prov:wasDerivedFrom ;
        sh:minCount 1 ;
        sh:message "A Candidate must be derived from at least one source entity."
    ] ;

    # ── Generation provenance ──────────────────────────────────────────

    # prov:wasGeneratedBy: exactly 1 extraction activity
    sh:property [
        sh:path prov:wasGeneratedBy ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Candidate must be generated by exactly one extraction activity."
    ] ;

    # prov:generatedAtTime: exactly 1 timestamp
    sh:property [
        sh:path prov:generatedAtTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Candidate must have exactly one generation timestamp."
    ] ;

    # generator: exactly 1 model/tool identifier string
    sh:property [
        sh:path projecta:generator ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Candidate must record the generator (model or tool identifier)."
    ] ;

    # proposedOntologyVersion: exactly 1 version string
    sh:property [
        sh:path projecta:proposedOntologyVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Candidate must record the ontology version under which it was proposed."
    ] ;

    # ── Verification state ─────────────────────────────────────────────

    # candidateStatus: exactly 1, must be a LifecycleStatus
    sh:property [
        sh:path projecta:candidateStatus ;
        sh:class projecta:LifecycleStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Candidate must have exactly one candidateStatus from the LifecycleStatus vocabulary."
    ] ;

    # candidateStatus must be one of the 8 permitted states
    sh:property [
        sh:path projecta:candidateStatus ;
        sh:in (
            projecta:extracted
            projecta:validated
            projecta:pending-review
            projecta:confirmed
            projecta:rejected
            projecta:asserted
            projecta:superseded
            projecta:retracted
        ) ;
        sh:message "A Candidate's status must be a valid LifecycleStatus value."
    ] ;

    # ── Project scope ──────────────────────────────────────────────────

    # belongsToProject: exactly 1
    sh:property [
        sh:path projecta:belongsToProject ;
        sh:class projecta:Project ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "A Candidate must belong to exactly one Project."
    ] ;

    # ── Rejection reason (conditional) ─────────────────────────────────

    # If candidateStatus is rejected, rejectionReason must be present
    sh:property [
        sh:path projecta:rejectionReason ;
        sh:datatype xsd:string ;
        sh:message "A rejected Candidate must have a rejection reason."
        # Conditional enforcement: minCount 1 when status = rejected.
        # Implemented via SPARQL constraint below.
    ] .

# ============================================================================
# CandidateRejectionShape — conditional: rejected → must have reason
# ============================================================================

projecta:CandidateRejectionShape a sh:NodeShape ;
    sh:targetClass projecta:Candidate ;
    rdfs:label "Candidate Rejection Reason Shape" ;
    rdfs:comment "If a Candidate has status rejected, it must carry a rejectionReason." ;
    sh:sparql [
        sh:message "A Candidate with status 'rejected' must have a rejectionReason." ;
        sh:select """
            PREFIX projecta: <https://w3id.org/projecta/ontology/>
            SELECT $this WHERE {
                $this projecta:candidateStatus projecta:rejected .
                FILTER NOT EXISTS {
                    $this projecta:rejectionReason ?reason .
                }
            }
            """
    ] .
