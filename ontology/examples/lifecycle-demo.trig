@prefix projecta: <https://w3id.org/projecta/ontology/> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .

# Lifecycle Demo Graph — Knowledge Lifecycle positive example.
# Maps to docs/use-cases/knowledge-lifecycle.md section 3.
#
# Extends the Sprint 1 quick-note-demo.trig scenario with the full
# lifecycle: source NoteItem → Candidate → Review → Asserted Requirement.
#
# Five named graphs per the named-graph contract (S2-10):
#   sources, candidates, asserted, inferred, provenance

# ============================================================================
# SOURCES GRAPH — Sprint 1 data (subset: entities needed for lifecycle)
# ============================================================================

GRAPH <https://w3id.org/projecta/data/project/ecommerce-checkout/sources/> {

  <https://w3id.org/projecta/data/project/ecommerce-checkout>
    a projecta:Project ;
    projecta:name "Ecommerce Checkout Redesign" .

  <https://w3id.org/projecta/data/project/ecommerce-checkout/person/le>
    a projecta:Person ;
    projecta:name "Le" .

  <https://w3id.org/projecta/data/project/ecommerce-checkout/note/sprint-review-2026-07-28>
    a projecta:Note ;
    projecta:name "2026-07-28 Sprint Review - Ecommerce Checkout" ;
    projecta:belongsToProject <https://w3id.org/projecta/data/project/ecommerce-checkout> ;
    projecta:authoredBy <https://w3id.org/projecta/data/project/ecommerce-checkout/person/le> ;
    projecta:recordedAt "2026-07-28T10:30:00Z"^^xsd:dateTime .

  # NI-1: Requirement — the source for the lifecycle demo
  <https://w3id.org/projecta/data/project/ecommerce-checkout/note-item/ni-1>
    a projecta:NoteItem ;
    projecta:isItemOf <https://w3id.org/projecta/data/project/ecommerce-checkout/note/sprint-review-2026-07-28> ;
    projecta:hasItemType projecta:requirement ;
    projecta:contentText "Khách hàng yêu cầu thêm bước xác nhận địa chỉ trước khi thanh toán. Cần làm rõ: có bắt buộc với KH đã lưu địa chỉ không?" .

  # NI-2 through NI-6 omitted for brevity — this fixture focuses on the lifecycle
  # of NI-1 only. The full 6-item note is in quick-note-demo.trig.

}

# ============================================================================
# CANDIDATES GRAPH — proposed knowledge, not yet confirmed
# ============================================================================

GRAPH <https://w3id.org/projecta/data/project/ecommerce-checkout/candidates/> {

  <https://w3id.org/projecta/data/project/ecommerce-checkout/candidate/req-address-confirmation>
    a projecta:Candidate ;
    rdfs:label "Address confirmation step before payment" ;
    projecta:candidateStatus projecta:confirmed ;
    projecta:generator "projecta-extractor-v0.2.0" ;
    projecta:proposedOntologyVersion "0.2.0" ;
    projecta:belongsToProject <https://w3id.org/projecta/data/project/ecommerce-checkout> ;
    prov:wasDerivedFrom <https://w3id.org/projecta/data/project/ecommerce-checkout/note-item/ni-1> ;
    prov:wasGeneratedBy <https://w3id.org/projecta/data/project/ecommerce-checkout/activity/extraction-001> ;
    prov:generatedAtTime "2026-07-29T09:00:00Z"^^xsd:dateTime .

}

# ============================================================================
# ASSERTED GRAPH — confirmed, human-validated knowledge
# ============================================================================

GRAPH <https://w3id.org/projecta/data/project/ecommerce-checkout/asserted/> {

  <https://w3id.org/projecta/data/project/ecommerce-checkout/requirement/req-address-confirmation>
    a projecta:KnowledgeItem, projecta:Requirement ;
    rdfs:label "Address confirmation step before payment" ;
    projecta:validFrom "2026-07-29"^^xsd:date ;
    projecta:belongsToProject <https://w3id.org/projecta/data/project/ecommerce-checkout> ;
    prov:wasDerivedFrom <https://w3id.org/projecta/data/project/ecommerce-checkout/candidate/req-address-confirmation> ;
    prov:wasAttributedTo <https://w3id.org/projecta/data/project/ecommerce-checkout/person/le> .

}

# ============================================================================
# INFERRED GRAPH — reserved, empty in Sprint 2
# ============================================================================

GRAPH <https://w3id.org/projecta/data/project/ecommerce-checkout/inferred/> {
  # Empty — no deterministic inference rules are implemented in Sprint 2.
  # Graph IRI is reserved for future use.
}

# ============================================================================
# PROVENANCE GRAPH — lifecycle activities and assertion metadata
# ============================================================================

GRAPH <https://w3id.org/projecta/data/project/ecommerce-checkout/provenance/> {

  # -- Extraction Activity -----------------------------------------------

  <https://w3id.org/projecta/data/project/ecommerce-checkout/activity/extraction-001>
    a prov:Activity ;
    rdfs:label "Candidate extraction from NoteItem" ;
    prov:used <https://w3id.org/projecta/data/project/ecommerce-checkout/note-item/ni-1> ;
    prov:generated <https://w3id.org/projecta/data/project/ecommerce-checkout/candidate/req-address-confirmation> ;
    prov:endedAtTime "2026-07-29T09:00:00Z"^^xsd:dateTime ;
    projecta:belongsToProject <https://w3id.org/projecta/data/project/ecommerce-checkout> .

  # -- Review Activity ---------------------------------------------------

  <https://w3id.org/projecta/data/project/ecommerce-checkout/activity/review-001>
    a prov:Activity ;
    rdfs:label "Human review — confirmed" ;
    prov:used <https://w3id.org/projecta/data/project/ecommerce-checkout/candidate/req-address-confirmation> ;
    prov:wasAssociatedWith <https://w3id.org/projecta/data/project/ecommerce-checkout/person/le> ;
    prov:endedAtTime "2026-07-29T10:15:00Z"^^xsd:dateTime ;
    projecta:reviewDecision projecta:confirmed ;
    projecta:belongsToProject <https://w3id.org/projecta/data/project/ecommerce-checkout> .

  # -- Assertion Activity ------------------------------------------------

  <https://w3id.org/projecta/data/project/ecommerce-checkout/activity/assertion-001>
    a prov:Activity ;
    rdfs:label "Candidate promoted to asserted fact" ;
    prov:used <https://w3id.org/projecta/data/project/ecommerce-checkout/candidate/req-address-confirmation> ;
    prov:generated <https://w3id.org/projecta/data/project/ecommerce-checkout/requirement/req-address-confirmation> ;
    prov:wasAssociatedWith <https://w3id.org/projecta/data/project/ecommerce-checkout/person/le> ;
    prov:endedAtTime "2026-07-29T10:15:00Z"^^xsd:dateTime ;
    projecta:belongsToProject <https://w3id.org/projecta/data/project/ecommerce-checkout> .

  # -- Assertion Metadata: rdf:Statement for validFrom -------------------

  <https://w3id.org/projecta/data/project/ecommerce-checkout/stmt/validfrom-001>
    a rdf:Statement ;
    rdf:subject <https://w3id.org/projecta/data/project/ecommerce-checkout/requirement/req-address-confirmation> ;
    rdf:predicate projecta:validFrom ;
    rdf:object "2026-07-29"^^xsd:date ;
    prov:wasAssociatedWith <https://w3id.org/projecta/data/project/ecommerce-checkout/person/le> ;
    prov:endedAtTime "2026-07-29T10:15:00Z"^^xsd:dateTime ;
    projecta:proposedOntologyVersion "0.2.0" ;
    projecta:belongsToProject <https://w3id.org/projecta/data/project/ecommerce-checkout> .

}
