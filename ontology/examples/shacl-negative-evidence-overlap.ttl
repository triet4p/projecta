@prefix projecta: <https://w3id.org/projecta/ontology/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/projecta/data/project/overlap-demo> a projecta:Project .
<https://w3id.org/projecta/data/project/overlap-demo/note/n>
  a projecta:Note ; projecta:rawText "ABCD" ;
  projecta:belongsToProject <https://w3id.org/projecta/data/project/overlap-demo> .
<https://w3id.org/projecta/data/project/overlap-demo/note-item/one>
  a projecta:NoteItem ; projecta:isItemOf <https://w3id.org/projecta/data/project/overlap-demo/note/n> ;
  projecta:contentText "AB" ; projecta:evidenceStartOffset "0"^^xsd:nonNegativeInteger ;
  projecta:evidenceEndOffset "2"^^xsd:positiveInteger .
<https://w3id.org/projecta/data/project/overlap-demo/note-item/two>
  a projecta:NoteItem ; projecta:isItemOf <https://w3id.org/projecta/data/project/overlap-demo/note/n> ;
  projecta:contentText "BC" ; projecta:evidenceStartOffset "1"^^xsd:nonNegativeInteger ;
  projecta:evidenceEndOffset "3"^^xsd:positiveInteger .
