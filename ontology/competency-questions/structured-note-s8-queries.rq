PREFIX projecta: <https://w3id.org/projecta/ontology/>

# CQ-S8-NOTE-001 — Note title, project, author, and capture time
SELECT ?title ?project ?author ?recordedAt WHERE {
  ?note a projecta:Note ;
    projecta:name ?title ;
    projecta:belongsToProject ?project ;
    projecta:authoredBy ?author ;
    projecta:recordedAt ?recordedAt .
}

# CQ-S8-NOTE-002 — Items are contained by exactly the requested Note
SELECT ?item ?type ?content WHERE {
  ?item a projecta:NoteItem ;
    projecta:isItemOf ?note ;
    projecta:hasItemType ?type ;
    projecta:contentText ?content .
  FILTER(?note = <https://w3id.org/projecta/data/project/structured-note-demo/note/s8-50-001>)
}

# CQ-S8-NOTE-003 — Textual order is a projection from evidence offsets
SELECT ?item ?start ?end WHERE {
  ?item a projecta:NoteItem ;
    projecta:isItemOf <https://w3id.org/projecta/data/project/structured-note-demo/note/s8-50-001> ;
    projecta:evidenceStartOffset ?start ;
    projecta:evidenceEndOffset ?end .
}
ORDER BY ?start

# CQ-S8-NOTE-004 — Source evidence does not create deferred assignment/deadline/status facts
ASK WHERE {
  <https://w3id.org/projecta/data/project/structured-note-demo/note/s8-50-001>
    projecta:assignedTo|projecta:deadline|projecta:dueAt|projecta:status ?value .
}
