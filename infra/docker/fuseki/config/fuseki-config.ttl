@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix tdb2: <http://jena.apache.org/2016/tdb#> .

[] a fuseki:Server ;
    fuseki:services ( <#projecta-service> ) .

<#projecta-service> a fuseki:Service ;
    fuseki:name "projecta" ;
    fuseki:serviceQuery "query" ;
    fuseki:serviceUpdate "update" ;
    fuseki:serviceReadGraphStore "get" ;
    fuseki:serviceReadWriteGraphStore "data" ;
    fuseki:dataset <#projecta-dataset> .

<#projecta-dataset> a tdb2:DatasetTDB2 ;
    tdb2:location "/var/lib/fuseki/databases/projecta" .
