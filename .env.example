# Projecta local Compose template. Copy to .env, then run
# ./scripts/setup-local-env.ps1 to generate unique secrets in that ignored file.
# Do not commit .env or reuse its credentials in production.
# See: docs/initialization/08-Deployment-Choice.md §5

# Local connector database. The bootstrap command fills the password.
PROJECTA_CONNECTOR_POSTGRES_USER=projecta
PROJECTA_CONNECTOR_POSTGRES_PASSWORD=replace-with-a-generated-local-password
PROJECTA_CONNECTOR_POSTGRES_DB=projecta

# Bootstrap generates these unique values locally; never commit the actual keys.
PROJECTA_API_SECRET_STORE_MASTER_KEY=replace-with-a-generated-fernet-key
PROJECTA_API_TRUSTED_CONTEXT_SECRET=replace-with-a-generated-context-secret
PROJECTA_API_RUNTIME_MODE=experience
PROJECTA_API_EXPERIENCE_PROJECT_CATALOG=project-alpha,project-beta
PROJECTA_API_EXPERIENCE_ACTOR_ID=local-operator
PROJECTA_BOOTSTRAP_ACCEPTANCE_PROJECTS=project-alpha|Project Alpha;project-beta|Project Beta

# No external provider is configured by default. Use Settings only if authorized.
PROJECTA_LLM_TYPE=
PROJECTA_LLM_BASE_URL=
PROJECTA_LLM_API_KEY=
PROJECTA_LLM_MODEL=

# Optional on-demand local suggestions. Ollama must run at 127.0.0.1:11434 inside
# the API container's network namespace; host-local Ollama is unreachable. The
# API never starts Ollama or pulls a model; empty disables suggestions and production
# always disables them.
PROJECTA_LOCAL_SUGGESTION_MODEL=

# Production identity (replace all placeholders for a separately reviewed
# production deployment; this local template alone cannot start production).
PROJECTA_API_OIDC_ISSUER_URL=https://auth.example.com/realms/projecta
PROJECTA_API_OIDC_CLIENT_ID=projecta-web
PROJECTA_API_OIDC_REDIRECT_URI=https://projecta.example.com/auth/callback
PROJECTA_API_OIDC_AUDIENCE=projecta-web
PROJECTA_API_OIDC_CA_FILE=/etc/projecta/oidc/ca.crt
PROJECTA_API_SESSION_COOKIE_SECURE=true
PROJECTA_API_IDENTITY_DATABASE_URL=postgresql+psycopg://projecta_app:managed-outside-git@connector-postgres:5432/projecta

# One existing PostgreSQL container, separate Keycloak database/user.
PROJECTA_KEYCLOAK_POSTGRES_DB=keycloak
PROJECTA_KEYCLOAK_POSTGRES_USER=keycloak
PROJECTA_KEYCLOAK_POSTGRES_PASSWORD=replace-with-a-secret-managed-outside-git
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.0@sha256:26939e1318d6f008fc2ee6e10cec1cf8f1ba8a21846c1bc81b91ed0506bc2a7a # linux/amd64 reviewed manifest
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=replace-with-one-time-operator-value
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-secret-managed-outside-git
EDGE_IMAGE=nginx:1.29.1@sha256:replace-with-reviewed-digest

# OpenBao production runtime. RoleID is transport material; SecretID is
# single-use and short-lived. Both files must remain outside Git.
OPENBAO_IMAGE=ghcr.io/openbao/openbao:2.6.1@sha256:15e90b578c970ae57b596ed51295380cd54f93860fe36758f05b455d71aae0e0
PROJECTA_API_OPENBAO_URL=https://openbao:8200
PROJECTA_OPENBAO_ROLE_ID_FILE=./.secrets/openbao-role-id
PROJECTA_OPENBAO_SECRET_ID_FILE=./.secrets/openbao-secret-id
