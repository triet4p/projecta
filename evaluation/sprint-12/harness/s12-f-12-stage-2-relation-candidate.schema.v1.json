{
  "$id": "s12.f12.stage2.relation-candidate.schema.v1",
  "title": "S12-f-12 server-owned candidate-table relation proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "predicate": {"enum": ["implements", "blocks", "dependsOn", "supports", "answers", "resolves", "constrainedBy"]},
    "sourceEntityId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "targetEntityId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"startOffset": {"type": "integer", "minimum": 0}, "endOffset": {"type": "integer", "exclusiveMinimum": 0}},
      "required": ["startOffset", "endOffset"]
    }
  },
  "required": ["predicate", "sourceEntityId", "targetEntityId", "confidence"],
  "x-boundary": "The model may reference only candidate IDs from the immutable server-owned table; it cannot create, retype, resize or rename entities.",
  "x-invariants": ["sourceEntityId and targetEntityId exist in candidate table", "sourceEntityId != targetEntityId", "predicate allowlisted", "evidence is validated server-side"]
}
