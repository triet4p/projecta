{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s12-f-12.stage2.relation-envelope.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "relations", "abstention"],
  "properties": {
    "schemaVersion": {"const": "s12-f-12.stage2.relation-envelope.v2"},
    "relations": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate", "sourceEntityId", "targetEntityId", "confidence", "triggerQuote", "evidence"],
        "properties": {
          "predicate": {"type": "string", "enum": ["implements", "blocks", "dependsOn", "supports", "answers", "resolves", "constrainedBy"]},
          "sourceEntityId": {"type": "string", "minLength": 1},
          "targetEntityId": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "triggerQuote": {"type": "string", "minLength": 1},
          "evidence": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["startOffset", "endOffset"],
            "properties": {
              "startOffset": {"type": "integer", "minimum": 0},
              "endOffset": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
