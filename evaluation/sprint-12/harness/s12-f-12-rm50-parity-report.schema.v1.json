{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s12-f-12.rm50-parity-report.v1",
  "type": "object", "additionalProperties": false,
  "required": ["artifactVersion", "status", "experimentId", "taskId", "sourceReports", "diagnosticContract", "fixtureContract", "scorerScenarioResults", "v9ClusterReproduction", "goldRelationsControl", "rawDataPolicy", "governance", "nextGate"],
  "properties": {
    "artifactVersion": {"const": "s12.s12-f-12.rm50-parity-report.v1"}, "status": {"const": "OFFLINE_PARITY_FIXTURES_VERIFIED_PENDING_OWNER_REVIEW"}, "experimentId": {"const": "s12-f-12"}, "taskId": {"const": "S12-RM-50"},
    "sourceReports": {"type": "object", "additionalProperties": false, "required": ["v6", "v9"], "properties": {"v6": {"$ref": "#/$defs/sourceDigest"}, "v9": {"$ref": "#/$defs/sourceDigest"}}},
    "diagnosticContract": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "optionAStopCriteriaPassed"], "properties": {"path": {"type": "string"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "optionAStopCriteriaPassed": {"const": true}}},
    "fixtureContract": {"type": "object", "additionalProperties": false, "required": ["path", "fixtureCount", "caseArmStageSliceCoverage", "schemaBoundaryCoverage", "evidenceBoundaryCoverage", "scorerScenarioCoverage"], "properties": {"path": {"type": "string"}, "fixtureCount": {"const": 26}, "caseArmStageSliceCoverage": {"const": true}, "schemaBoundaryCoverage": {"type": "array", "minItems": 9, "items": {"type": "string"}}, "evidenceBoundaryCoverage": {"type": "array", "minItems": 10, "items": {"type": "string"}}, "scorerScenarioCoverage": {"type": "array", "minItems": 7, "items": {"type": "string"}}}},
    "scorerScenarioResults": {"type": "object", "minProperties": 7, "additionalProperties": {"$ref": "#/$defs/scorerResult"}},
    "v9ClusterReproduction": {"type": "object", "additionalProperties": false, "required": ["schemaInvalidTotal", "invalidEvidenceTotal", "triggerContainment", "endpointContainment", "reproducedWithoutProviderOrRawReconstruction"], "properties": {"schemaInvalidTotal": {"type": "integer", "minimum": 0}, "invalidEvidenceTotal": {"type": "integer", "minimum": 0}, "triggerContainment": {"type": "integer", "minimum": 0}, "endpointContainment": {"type": "integer", "minimum": 0}, "reproducedWithoutProviderOrRawReconstruction": {"const": true}}},
    "goldRelationsControl": {"type": "object", "additionalProperties": false, "required": ["fixtureArm", "invalidEvidence", "integrityPass"], "properties": {"fixtureArm": {"const": "gold-relations"}, "invalidEvidence": {"const": 0}, "integrityPass": {"const": true}}},
    "rawDataPolicy": {"type": "object", "additionalProperties": false, "required": ["rawProviderPayloadIncluded", "rawSourceTextIncluded", "rawTriggerQuoteIncluded", "rawValidationDetailIncluded", "recursiveDynamicKeyExclusion"], "properties": {"rawProviderPayloadIncluded": {"const": false}, "rawSourceTextIncluded": {"const": false}, "rawTriggerQuoteIncluded": {"const": false}, "rawValidationDetailIncluded": {"const": false}, "recursiveDynamicKeyExclusion": {"const": true}}},
    "governance": {"type": "object", "additionalProperties": false, "required": ["offlineOnly", "providerCalls", "runtimeRemediationAuthorized", "supersedingLineagePreparationAuthorized", "preregistrationIssued", "technicalFreezeIssued", "newAuthorizationIssued", "providerExecutionAuthorized", "validationAccessAuthorized", "heldOutAccessAuthorized", "stageBAuthorized", "candidateSelectionAuthorized", "promotionAuthorized"], "properties": {"offlineOnly": {"const": true}, "providerCalls": {"const": 0}, "runtimeRemediationAuthorized": {"const": false}, "supersedingLineagePreparationAuthorized": {"const": false}, "preregistrationIssued": {"const": false}, "technicalFreezeIssued": {"const": false}, "newAuthorizationIssued": {"const": false}, "providerExecutionAuthorized": {"const": false}, "validationAccessAuthorized": {"const": false}, "heldOutAccessAuthorized": {"const": false}, "stageBAuthorized": {"const": false}, "candidateSelectionAuthorized": {"const": false}, "promotionAuthorized": {"const": false}}},
    "nextGate": {"const": "S12-RM-51_OWNER_REVIEW_RM50_OFFLINE_DIAGNOSTICS_AND_PARITY_FIXTURES"}
  },
  "$defs": {
    "sourceDigest": {"type": "object", "additionalProperties": false, "required": ["digest"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
    "scorerResult": {"type": "object", "additionalProperties": false, "required": ["gold", "predicted", "exactMatch", "missingRelation", "extraRelation", "reversedEndpoint", "wrongEndpoint", "wrongPredicate", "goldReconciled", "predictedReconciled", "tieOrderDeterministic", "unusedGoldKeys", "unusedPredictedKeys"], "properties": {"gold": {"type": "integer", "minimum": 0}, "predicted": {"type": "integer", "minimum": 0}, "exactMatch": {"type": "integer", "minimum": 0}, "missingRelation": {"type": "integer", "minimum": 0}, "extraRelation": {"type": "integer", "minimum": 0}, "reversedEndpoint": {"type": "integer", "minimum": 0}, "wrongEndpoint": {"type": "integer", "minimum": 0}, "wrongPredicate": {"type": "integer", "minimum": 0}, "goldReconciled": {"const": true}, "predictedReconciled": {"const": true}, "tieOrderDeterministic": {"const": true}, "unusedGoldKeys": {"type": "array", "items": {"type": "string"}}, "unusedPredictedKeys": {"type": "array", "items": {"type": "string"}}}}
  }
}
