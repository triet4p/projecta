{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "s12-f-12.stage1.entity-envelope.v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entities", "abstention"],
  "properties": {
    "schemaVersion": {"const": "s12-f-12.stage1.entity-envelope.v2"},
    "entities": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateId", "type", "startOffset", "endOffset", "confidence"],
        "properties": {
          "candidateId": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["Requirement", "Decision", "Question", "Task", "Risk", "Assumption", "Constraint", "ProgressClaim", "ResearchFinding"]},
          "startOffset": {"type": "integer", "minimum": 0},
          "endOffset": {"type": "integer", "minimum": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "abstention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason"],
      "properties": {
        "required": {"type": "boolean"},
        "reason": {"type": ["string", "null"]}
      }
    }
  }
}
