    "thresholds": {"type": "object", "additionalProperties": false, "required": ["entityMacroF1Min", "entitySpanExactMin", "entityHallucinationRateMax", "abstentionPrecisionMin", "abstentionRecallMin", "abstentionF1Min", "relationSemanticMicroF1Min", "relationSemanticMacroF1Min", "predicateAccuracyMin", "endpointDirectionAccuracyMin", "missingEndpointRateMax", "reversedEndpointRateMax", "relationEvidenceSupportMin", "relationEvidenceExactMin", "relationHallucinationRateMax", "hardFailureCount", "retryCount", "pricingFailureCount", "goldRelationsIntegrityScore", "goldRelationsMaterializerFailures"], "properties": {"entityMacroF1Min": {"type": "number"}, "entitySpanExactMin": {"type": "number"}, "entityHallucinationRateMax": {"type": "number"}, "abstentionPrecisionMin": {"type": "number"}, "abstentionRecallMin": {"type": "number"}, "abstentionF1Min": {"type": "number"}, "relationSemanticMicroF1Min": {"type": "number"}, "relationSemanticMacroF1Min": {"type": "number"}, "predicateAccuracyMin": {"type": "number"}, "endpointDirectionAccuracyMin": {"type": "number"}, "missingEndpointRateMax": {"type": "number"}, "reversedEndpointRateMax": {"type": "number"}, "relationEvidenceSupportMin": {"type": "number"}, "relationEvidenceExactMin": {"type": "number"}, "relationHallucinationRateMax": {"type": "number"}, "hardFailureCount": {"type": "number"}, "retryCount": {"type": "number"}, "pricingFailureCount": {"type": "number"}, "goldRelationsIntegrityScore": {"type": "number"}, "goldRelationsMaterializerFailures": {"type": "number"}}},
