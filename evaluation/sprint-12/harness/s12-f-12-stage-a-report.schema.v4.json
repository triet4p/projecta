    "counts": {"type": "object", "additionalProperties": false, "required": ["exactMatch", "wrongPredicate", "reversedEndpoint", "wrongEndpoint", "missingRelation", "extraRelation"], "properties": {"exactMatch": {"type": "integer", "minimum": 0}, "wrongPredicate": {"type": "integer", "minimum": 0}, "reversedEndpoint": {"type": "integer", "minimum": 0}, "wrongEndpoint": {"type": "integer", "minimum": 0}, "missingRelation": {"type": "integer", "minimum": 0}, "extraRelation": {"type": "integer", "minimum": 0}}},
