    "evidence": {"type": "object", "additionalProperties": false, "required": ["counts", "semanticTruePositiveDenominator", "applicable", "reconciled", "supportRate", "exactRate"], "properties": {"counts": {"$ref": "#/$defs/evidenceCounts"}, "semanticTruePositiveDenominator": {"type": "integer"}, "applicable": {"type": "integer"}, "reconciled": {"type": "boolean"}, "supportRate": {"type": ["number", "string"]}, "exactRate": {"type": ["number", "string"]}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["semantic", "endpointResolution", "evidence", "invalidEvidenceCount", "endpointContractFailure", "configurationMismatch"], "properties": {"semantic": {"$ref": "#/$defs/semantic"}, "endpointResolution": {"$ref": "#/$defs/endpoint"}, "evidence": {"$ref": "#/$defs/evidence"}, "invalidEvidenceCount": {"type": "integer"}, "endpointContractFailure": {"type": "integer"}, "configurationMismatch": {"type": "integer"}}},
    "stage": {"type": "object", "additionalProperties": false, "required": ["responseReceived", "schemaValid", "failureClass", "responseDigest"], "properties": {"responseReceived": {"type": "boolean"}, "schemaValid": {"type": "boolean"}, "failureClass": {"type": ["string", "null"]}, "responseDigest": {"type": ["string", "null"]}, "candidateTableDigest": {"type": ["string", "null"]}}},
    "arm": {"type": "object", "additionalProperties": false, "required": ["caseRuns", "goldRelationInstances", "goldAbstentionInstances", "entity", "abstention", "relation", "thresholdsPass", "thresholdFailures"], "properties": {"caseRuns": {"type": "integer"}, "goldRelationInstances": {"type": "integer"}, "goldAbstentionInstances": {"type": "integer"}, "entity": {"$ref": "#/$defs/entity"}, "abstention": {"$ref": "#/$defs/abstention"}, "relation": {"$ref": "#/$defs/relation"}, "thresholdsPass": {"type": "boolean"}, "thresholdFailures": {"type": "array", "items": {"type": "string"}}}},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["arms", "hardGates", "thresholds", "goldRelationsIntegrityScore", "goldRelationsMaterializerFailures", "sliceGatesPass"], "properties": {"arms": {"type": "object", "additionalProperties": false, "required": ["predicted-entities", "gold-entities", "gold-relations"], "properties": {"predicted-entities": {"$ref": "#/$defs/arm"}, "gold-entities": {"$ref": "#/$defs/arm"}, "gold-relations": {"$ref": "#/$defs/arm"}}}, "hardGates": {"$ref": "#/$defs/hardGates"}, "thresholds": {"$ref": "#/$defs/thresholds"}, "goldRelationsIntegrityScore": {"type": "number"}, "goldRelationsMaterializerFailures": {"type": "integer"}, "sliceGatesPass": {"type": "boolean"}}},
    "caseArm": {"type": "object", "additionalProperties": false, "required": ["stage1", "stage2", "entity", "abstention", "relation", "configurationFingerprint", "invalidEvidenceCount", "endpointContractFailure", "configurationMismatch"], "properties": {"stage1": {"$ref": "#/$defs/stage"}, "stage2": {"$ref": "#/$defs/stage"}, "entity": {"$ref": "#/$defs/entity"}, "abstention": {"$ref": "#/$defs/abstention"}, "relation": {"$ref": "#/$defs/relation"}, "configurationFingerprint": {"type": "string"}, "invalidEvidenceCount": {"type": "integer"}, "endpointContractFailure": {"type": "integer"}, "configurationMismatch": {"type": "integer"}}},
    "caseRecord": {"type": "object", "additionalProperties": false, "required": ["caseId", "runId", "journeyId", "language", "goldRelationCount", "goldAbstentionRequired", "arms"], "properties": {"caseId": {"type": "string"}, "runId": {"type": "integer", "enum": [1, 2, 3]}, "journeyId": {"type": "string"}, "language": {"type": "string"}, "goldRelationCount": {"type": "integer"}, "goldAbstentionRequired": {"type": "boolean"}, "arms": {"type": "object", "additionalProperties": false, "required": ["predicted-entities", "gold-entities", "gold-relations"], "properties": {"predicted-entities": {"$ref": "#/$defs/caseArm"}, "gold-entities": {"$ref": "#/$defs/caseArm"}, "gold-relations": {"$ref": "#/$defs/caseArm"}}}}},
    "sliceRecord": {"type": "object", "additionalProperties": false, "required": ["dimension", "label", "denominator", "metrics"], "properties": {"dimension": {"enum": ["all-development", "relation-positive", "relation-negative", "abstention-required", "abstention-not-required", "journey", "language"]}, "label": {"type": "string"}, "denominator": {"type": "integer", "minimum": 0}, "metrics": {"type": "object", "additionalProperties": false, "required": ["arms", "gate"], "properties": {"arms": {"type": "object", "additionalProperties": false, "required": ["predicted-entities", "gold-entities", "gold-relations"], "properties": {"predicted-entities": {"$ref": "#/$defs/arm"}, "gold-entities": {"$ref": "#/$defs/arm"}, "gold-relations": {"$ref": "#/$defs/arm"}}}, "gate": {"type": "object", "additionalProperties": false, "required": ["predicted-entities", "gold-entities"], "properties": {"predicted-entities": {"type": "boolean"}, "gold-entities": {"type": "boolean"}}}}}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["status", "hardGatesPass", "thresholdsPass", "sliceGatesPass", "goldRelationsIntegrityPass", "costCeilingPass", "failedGates", "outputPath"], "properties": {"status": {"enum": ["COMPLETED", "COMPLETED_REJECTED_HARD_GATE"]}, "hardGatesPass": {"type": "boolean"}, "thresholdsPass": {"type": "boolean"}, "sliceGatesPass": {"type": "boolean"}, "goldRelationsIntegrityPass": {"type": "boolean"}, "costCeilingPass": {"type": "boolean"}, "failedGates": {"type": "array", "items": {"type": "string"}}, "outputPath": {"type": "string"}}}
