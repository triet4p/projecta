{
  "$id": "s12.f12.stage1.entity-candidate.schema.v1",
  "title": "S12-f-12 server-materialized entity candidate proposal",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidateId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "type": {"enum": ["Requirement", "Decision", "Question", "Task", "Risk", "Assumption", "Constraint", "ProgressClaim", "ResearchFinding"]},
    "startOffset": {"type": "integer", "minimum": 0},
    "endOffset": {"type": "integer", "exclusiveMinimum": 0},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "required": ["candidateId", "type", "startOffset", "endOffset", "confidence"],
  "x-boundary": "The model proposes only typed spans; the server owns label/evidence materialization and candidate identity.",
  "x-invariants": ["candidateId unique per response", "startOffset < endOffset", "endOffset within runtime source", "no duplicate typed spans"]
}
