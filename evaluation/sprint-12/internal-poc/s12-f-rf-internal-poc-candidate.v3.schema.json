{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projecta.example/schemas/s12-f-rf-internal-poc-candidate.v3.json",
  "title": "Sprint 12 F-RF Frozen Internal Agent Candidate v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactVersion", "status", "candidateModel", "reasoning", "agentCandidateCalls", "providerCalls", "payloadPath", "payloadDigest", "records", "goldIncluded", "priorScoresIncluded", "priorReviewsIncluded", "heldOutInspection", "rawSensitiveDataIncluded", "reviewOrScoringPerformed", "nonClaims", "candidateDigest"],
  "properties": {
    "artifactVersion": {"const": "s12.f-rf.internal-poc-candidate.v3"},
    "status": {"const": "CANDIDATE_FROZEN_FOR_PROXY_REVIEW_ONLY"},
    "candidateModel": {"const": "gpt-5.6-luna"},
    "reasoning": {"const": "high"},
    "agentCandidateCalls": {"const": 12},
    "providerCalls": {"const": 0},
    "payloadPath": {"const": "evaluation/sprint-12/internal-poc/s12-f-rf-blinded-source-payload.v3.json"},
    "payloadDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "records": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/record"}},
    "goldIncluded": {"const": false},
    "priorScoresIncluded": {"const": false},
    "priorReviewsIncluded": {"const": false},
    "heldOutInspection": {"const": false},
    "rawSensitiveDataIncluded": {"const": false},
    "reviewOrScoringPerformed": {"const": false},
    "nonClaims": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "candidateDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "record": {"type": "object", "additionalProperties": false, "required": ["caseId", "scenarioId", "language", "sourceDigest", "sourceVersion", "response", "responseDigest"], "properties": {"caseId": {"pattern": "^s12-a-[0-9]{4}$"}, "scenarioId": {"pattern": "^s12-s-[0-9]{3}$"}, "language": {"enum": ["vi", "en", "ja", "mixed"]}, "sourceDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}, "sourceVersion": {"type": "object", "required": ["sourceVersionId", "projectScopeId", "canonicalContentDigest", "coordinateSystemVersion", "receiptDigest"]}, "response": {"type": "object", "required": ["schemaVersion", "modelId", "modelVersion", "entities", "relations", "links"], "properties": {"schemaVersion": {"const": "m3.v2"}, "modelId": {"const": "gpt-5.6-luna"}, "modelVersion": {"const": "internal-poc-v3"}, "entities": {"type": "array", "minItems": 1}, "relations": {"const": []}, "links": {"const": []}}}, "responseDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}}}
  }
}
