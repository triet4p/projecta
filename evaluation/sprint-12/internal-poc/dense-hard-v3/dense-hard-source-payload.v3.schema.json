{
  "$id": "https://projecta.example/schemas/s12-dense-hard-source-payload.v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifactVersion": {
      "const": "s12.dense-hard.source-payload.v3"
    },
    "datasetKind": {
      "const": "SYNTHETIC_NON_PRODUCTION"
    },
    "evaluatorManifestIncluded": {
      "const": false
    },
    "goldIncluded": {
      "const": false
    },
    "heldOutInspection": {
      "const": false
    },
    "payloadDigest": {
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "providerCalls": {
      "const": 0
    },
    "records": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "caseId": {
            "pattern": "^dh3-[0-9]{3}$"
          },
          "language": {
            "enum": [
              "en",
              "vi",
              "ja",
              "mixed"
            ]
          },
          "rawText": {
            "minLength": 1,
            "type": "string"
          },
          "scenarioId": {
            "pattern": "^dh3-s-[0-9]{3}$"
          },
          "slices": {
            "items": {
              "enum": [
                "multi-hop",
                "multi-relation",
                "repeated-labels",
                "different-occurrences",
                "negation",
                "non-assertion",
                "abstention",
                "ambiguity",
                "temporal-supersession",
                "stale-statement",
                "mixed-unicode",
                "combining-mark",
                "emoji",
                "cross-sentence-dependency",
                "distractors",
                "cross-project",
                "unsupported-relation",
                "adversarial-instruction",
                "partial-abstention",
                "full-abstention",
                "long-context",
                "type-ambiguity"
              ]
            },
            "minItems": 1,
            "type": "array"
          },
          "sourceDigest": {
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "caseId",
          "scenarioId",
          "language",
          "slices",
          "rawText",
          "sourceDigest"
        ],
        "type": "object"
      },
      "maxItems": 30,
      "minItems": 30,
      "type": "array"
    },
    "requiredOutputSchema": {
      "additionalProperties": false,
      "properties": {
        "abstentionRule": {
          "type": "string"
        },
        "anchorRule": {
          "type": "string"
        },
        "protocolPath": {
          "const": "evaluation/sprint-12/internal-poc/dense-hard-v3/dense-hard-source-only-protocol.v3.json"
        },
        "schemaVersion": {
          "const": "dense-hard-output.v3"
        }
      },
      "required": [
        "schemaVersion",
        "protocolPath",
        "anchorRule",
        "abstentionRule"
      ],
      "type": "object"
    },
    "sourceOnly": {
      "const": true
    },
    "status": {
      "const": "FROZEN_SOURCE_ONLY_FOR_CANDIDATE"
    }
  },
  "required": [
    "artifactVersion",
    "status",
    "datasetKind",
    "sourceOnly",
    "goldIncluded",
    "evaluatorManifestIncluded",
    "providerCalls",
    "heldOutInspection",
    "requiredOutputSchema",
    "records",
    "payloadDigest"
  ],
  "title": "Sprint 12 Dense-Hard v3 Source Only",
  "type": "object"
}
