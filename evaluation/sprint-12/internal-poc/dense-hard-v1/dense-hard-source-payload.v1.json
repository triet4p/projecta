      "sourceDigest": "sha256:6792011e3d7e31cf10c4a47d017f40b5604777668277779afc93f53a63c0a1e8"
    },
    {
      "caseId": "dh-010",
      "language": "en",
      "rawText": "Yesterday's policy blocks the legacy path. Today's policy supersedes yesterday's policy. The active path dependsOn today's policy.",
      "scenarioId": "dh-s-010",
      "slices": [
        "temporal-supersession",
        "stale-statement"
      ],
      "sourceDigest": "sha256:517786103d564891f5f834cb6c8e6c579c11dae2ce1f2c9c78abdfbe7f0ba04b"
    },
    {
      "caseId": "dh-011",
      "language": "en",
      "rawText": "Design note names the service boundary. That boundary supports the ingestion task. The ingestion task dependsOn the schema check.",
