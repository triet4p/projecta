    },
    {
      "caseId": "dh-003",
      "language": "vi",
      "rawText": "Quy trình thanh toán phụ thuộc vào cổng đối soát. Cổng đối soát hỗ trợ ledger nội bộ. Ledger nội bộ bị chặn bởi dữ liệu thiếu.",
      "scenarioId": "dh-s-003",
      "slices": [
        "multi-hop",
        "mixed-unicode"
      ],
      "sourceDigest": "sha256:28f32c4b248bd039526850b7689a7d31dfc723a98a590557854bbf4246142fe3"
    },
    {
      "caseId": "dh-004",
      "language": "ja",
      "rawText": "監査計画は証跡台帳に依存する。証跡台帳は保持方針を実装する。保持方針は古い記録の削除を防ぐ。",
      "scenarioId": "dh-s-004",
      "slices": [
        "multi-hop",
        "mixed-unicode"
      ],
      "sourceDigest": "sha256:88c1e5c44f02aa8b1450d5fdf7356798fb8330efb995cb93324d787ee46da9f2"
    },
    {
      "caseId": "dh-005",
      "language": "en",
      "rawText": "Review queue tracks owner note. Owner note supports review queue. A second owner note blocks archive job.",
      "scenarioId": "dh-s-005",
      "slices": [
        "repeated-labels",
        "different-occurrences"
      ],
      "sourceDigest": "sha256:cccd68c4316bd494ff379bf495f5b7bb25751113e89035de95d04c070b3b25e6"
    },
    {
      "caseId": "dh-006",
      "language": "en",
      "rawText": "Policy label constrains intake form. Policy label also supports audit form. Audit form dependsOn policy label.",
      "scenarioId": "dh-s-006",
      "slices": [
        "repeated-labels",
        "different-occurrences"
      ],
      "sourceDigest": "sha256:7129f24a9ba313eb0dac1088f64ffe9d1c7991e9ad4952ae17e3780e98ee0113"
    },
    {
      "caseId": "dh-007",
      "language": "en",
      "rawText": "Cache refresh does not block deploy. The team must not assert that the cache refresh supports release gate.",
      "scenarioId": "dh-s-007",
      "slices": [
        "negation",
        "non-assertion",
        "abstention"
      ],
      "sourceDigest": "sha256:637ed7dccbb8544fb5b392351b21ce1f177358a9aa8a76d8d43852169b650ff6"
    },
    {
      "caseId": "dh-008",
      "language": "en",
      "rawText": "Maybe the vendor portal implements the billing rule. It is unclear whether the billing rule blocks payment.",
      "scenarioId": "dh-s-008",
      "slices": [
        "ambiguity",
        "abstention"
      ],
      "sourceDigest": "sha256:e25ceb53c205f015d1ebde3dc13854c0ca2825d1d3d76f67f6b27df8a434f333"
    },
    {
      "caseId": "dh-009",
      "language": "en",
      "rawText": "Version 1 runbook supports the old queue. Version 2 runbook supersedes version 1 runbook. The current queue dependsOn version 2 runbook.",
      "scenarioId": "dh-s-009",
      "slices": [
        "temporal-supersession",
        "stale-statement"
