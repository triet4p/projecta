    },
    {
      "caseId": "dh-013",
      "language": "en",
      "rawText": "Deployment plan implements release gate. Release gate blocks unverified artifact. Marketing copy mentions launch promise. Lunch menu mentions release gate but is unrelated. Unverified artifact dependsOn checksum.",
