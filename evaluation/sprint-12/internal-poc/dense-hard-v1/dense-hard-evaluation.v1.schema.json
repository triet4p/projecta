{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projecta.example/schemas/s12-dense-hard-evaluation.v1.json",
  "title": "Sprint 12 Dense-Hard Frozen Candidate Evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactVersion", "status", "datasetKind", "evaluatorVersion", "sourcePayloadPath", "sourcePayloadDigest", "goldPath", "goldDigest", "manifestPath", "manifestDigest", "candidatePath", "candidateDigest", "candidateModel", "providerCalls", "antiLeakChecks", "counts", "perItemClassificationCounts", "semanticEditCounts", "entityMetrics", "relationMetrics", "abstentionMetrics", "unsupportedFinalizedAssertions", "hallucinatedFinalizedAssertions", "rm67", "perItem", "perSlice", "difficultyTiers", "worstCases", "errorTaxonomy", "nonClaims", "evaluationDigest"],
  "properties": {
    "artifactVersion": {"const": "s12.dense-hard.evaluation.v1"},
    "status": {"const": "EVALUATED_FROZEN_CANDIDATE"},
    "datasetKind": {"const": "SYNTHETIC_NON_PRODUCTION"},
    "evaluatorVersion": {"const": "s12.dense-hard.evaluator.v1"},
    "sourcePayloadPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v1/dense-hard-source-payload.v1.json"},
    "sourcePayloadDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "goldPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v1/dense-hard-gold.v1.json"},
    "goldDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "manifestPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v1/dense-hard-evaluator-manifest.v1.json"},
    "manifestDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "candidatePath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v1/dense-hard-candidate.v1.json"},
    "candidateDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "candidateModel": {"const": "gpt-5.6-luna"},
    "providerCalls": {"const": 0},
    "antiLeakChecks": {"$ref": "#/$defs/antiLeak"},
    "counts": {"$ref": "#/$defs/counts"},
    "perItemClassificationCounts": {"$ref": "#/$defs/classificationCounts"},
    "semanticEditCounts": {"type": "object", "additionalProperties": false, "required": ["total", "meanPerCase"], "properties": {"total": {"type": "integer", "minimum": 0}, "meanPerCase": {"type": "number", "minimum": 0}}},
    "entityMetrics": {"$ref": "#/$defs/metric"},
    "relationMetrics": {"$ref": "#/$defs/metric"},
    "abstentionMetrics": {"$ref": "#/$defs/abstention"},
    "unsupportedFinalizedAssertions": {"$ref": "#/$defs/assertionCount"},
    "hallucinatedFinalizedAssertions": {"$ref": "#/$defs/hallucinationCount"},
    "rm67": {"$ref": "#/$defs/rm67"},
    "perItem": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/item"}},
    "perSlice": {"type": "object", "minProperties": 19, "additionalProperties": {"$ref": "#/$defs/slice"}},
    "difficultyTiers": {"type": "object", "minProperties": 3, "additionalProperties": {"$ref": "#/$defs/slice"}},
    "worstCases": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/worst"}},
    "errorTaxonomy": {"$ref": "#/$defs/taxonomy"},
    "nonClaims": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "evaluationDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "antiLeak": {"type": "object", "additionalProperties": false, "required": ["candidateDigestBound", "sourceDigestBound", "goldDigestBound", "manifestDigestBound", "candidateSourceOnlyFlagsClean", "goldExcludedFromCandidate", "providerCallsZero", "heldOutInspectionFalse", "fRfStateChanged"], "properties": {"candidateDigestBound": {"const": true}, "sourceDigestBound": {"const": true}, "goldDigestBound": {"const": true}, "manifestDigestBound": {"const": true}, "candidateSourceOnlyFlagsClean": {"const": true}, "goldExcludedFromCandidate": {"const": true}, "providerCallsZero": {"const": true}, "heldOutInspectionFalse": {"const": true}, "fRfStateChanged": {"const": false}}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["caseCount", "entityGold", "entityCandidate", "relationGold", "relationCandidate"], "properties": {"caseCount": {"const": 24}, "entityGold": {"const": 101}, "entityCandidate": {"type": "integer", "minimum": 0}, "relationGold": {"const": 49}, "relationCandidate": {"type": "integer", "minimum": 0}}},
    "classificationCounts": {"type": "object", "additionalProperties": false, "required": ["unchanged", "minor", "major", "reject", "abstain"], "properties": {"unchanged": {"type": "integer", "minimum": 0}, "minor": {"type": "integer", "minimum": 0}, "major": {"type": "integer", "minimum": 0}, "reject": {"type": "integer", "minimum": 0}, "abstain": {"type": "integer", "minimum": 0}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["tp", "fp", "fn", "precision", "recall", "f1"], "properties": {"tp": {"type": "integer", "minimum": 0}, "fp": {"type": "integer", "minimum": 0}, "fn": {"type": "integer", "minimum": 0}, "precision": {"type": "number", "minimum": 0, "maximum": 1}, "recall": {"type": "number", "minimum": 0, "maximum": 1}, "f1": {"type": "number", "minimum": 0, "maximum": 1}}},
    "rate3": {"type": "object", "additionalProperties": false, "required": ["required", "predicted", "correct", "precision", "recall"], "properties": {"required": {"type": "integer", "minimum": 0}, "predicted": {"type": "integer", "minimum": 0}, "correct": {"type": "integer", "minimum": 0}, "precision": {"type": "number", "minimum": 0, "maximum": 1}, "recall": {"type": "number", "minimum": 0, "maximum": 1}}},
    "abstention": {"type": "object", "additionalProperties": false, "required": ["required", "predicted", "truePositive", "precision", "recall", "full", "partial"], "properties": {"required": {"type": "integer", "minimum": 0}, "predicted": {"type": "integer", "minimum": 0}, "truePositive": {"type": "integer", "minimum": 0}, "precision": {"type": "number", "minimum": 0, "maximum": 1}, "recall": {"type": "number", "minimum": 0, "maximum": 1}, "full": {"$ref": "#/$defs/rate3"}, "partial": {"$ref": "#/$defs/rate3"}}},
    "assertionCount": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator", "status"], "properties": {"numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 0}, "status": {"enum": ["ZERO_UNSUPPORTED", "UNSUPPORTED_PRESENT"]}}},
    "hallucinationCount": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator", "status"], "properties": {"numerator": {"type": "integer", "minimum": 0}, "denominator": {"type": "integer", "minimum": 0}, "status": {"enum": ["ZERO_HALLUCINATED", "HALLUCINATED_PRESENT"]}}},
    "rm67": {"type": "object", "additionalProperties": false, "required": ["thresholds", "acceptedWithoutSemanticCorrection", "acceptedUnchangedOrMinor", "meanSemanticEditsPerReviewedItem", "unsupportedFinalizedAssertions", "editBurdenGate"], "properties": {"thresholds": {"type": "object", "additionalProperties": false, "required": ["acceptedWithoutSemanticCorrectionMinimum", "acceptedUnchangedOrMinorMinimum", "meanSemanticEditsMaximum", "unsupportedFinalizedAssertionsMaximum"], "properties": {"acceptedWithoutSemanticCorrectionMinimum": {"const": 0.7}, "acceptedUnchangedOrMinorMinimum": {"const": 0.85}, "meanSemanticEditsMaximum": {"const": 2.0}, "unsupportedFinalizedAssertionsMaximum": {"const": 0}}}, "acceptedWithoutSemanticCorrection": {"type": "number", "minimum": 0, "maximum": 1}, "acceptedUnchangedOrMinor": {"type": "number", "minimum": 0, "maximum": 1}, "meanSemanticEditsPerReviewedItem": {"type": "number", "minimum": 0}, "unsupportedFinalizedAssertions": {"$ref": "#/$defs/assertionCount"}, "editBurdenGate": {"type": "boolean"}}},
    "dimensionDiffs": {"type": "object", "additionalProperties": false, "required": ["entity_span", "entity_type", "entity_label", "entity_missing", "entity_extra"], "properties": {"entity_span": {"type": "integer", "minimum": 0}, "entity_type": {"type": "integer", "minimum": 0}, "entity_label": {"type": "integer", "minimum": 0}, "entity_missing": {"type": "integer", "minimum": 0}, "entity_extra": {"type": "integer", "minimum": 0}}},
    "relationDiffs": {"type": "object", "additionalProperties": false, "required": ["relation_predicate", "relation_endpoint", "relation_evidence", "relation_missing", "relation_extra"], "properties": {"relation_predicate": {"type": "integer", "minimum": 0}, "relation_endpoint": {"type": "integer", "minimum": 0}, "relation_evidence": {"type": "integer", "minimum": 0}, "relation_missing": {"type": "integer", "minimum": 0}, "relation_extra": {"type": "integer", "minimum": 0}}},
    "itemMetric": {"type": "object", "additionalProperties": false, "required": ["gold", "candidate", "tp", "fp", "fn", "precision", "recall", "f1", "dimensionDiffs"], "properties": {"gold": {"type": "integer", "minimum": 0}, "candidate": {"type": "integer", "minimum": 0}, "tp": {"type": "integer", "minimum": 0}, "fp": {"type": "integer", "minimum": 0}, "fn": {"type": "integer", "minimum": 0}, "precision": {"type": "number", "minimum": 0, "maximum": 1}, "recall": {"type": "number", "minimum": 0, "maximum": 1}, "f1": {"type": "number", "minimum": 0, "maximum": 1}, "dimensionDiffs": {"oneOf": [{"$ref": "#/$defs/dimensionDiffs"}, {"$ref": "#/$defs/relationDiffs"}]}}},
    "item": {"type": "object", "additionalProperties": false, "required": ["caseId", "scenarioId", "slices", "difficultyTier", "classification", "goldAbstentionRequired", "expectedAbstentionMode", "candidateAbstentionStatus", "abstentionCorrect", "semanticEditCount", "unsupportedFinalizedAssertions", "hallucinatedFinalizedAssertions", "errorCodes", "entity", "relation"], "properties": {"caseId": {"pattern": "^dh-[0-9]{3}$"}, "scenarioId": {"pattern": "^dh-s-[0-9]{3}$"}, "slices": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "difficultyTier": {"enum": ["dense-baseline", "dense-disambiguation", "dense-adversarial-abstention"]}, "classification": {"enum": ["unchanged", "minor", "major", "reject", "abstain"]}, "goldAbstentionRequired": {"type": "boolean"}, "expectedAbstentionMode": {"type": ["string", "null"], "enum": ["full", "partial", null]}, "candidateAbstentionStatus": {"enum": ["none", "partial", "full"]}, "abstentionCorrect": {"type": "boolean"}, "semanticEditCount": {"type": "integer", "minimum": 0}, "unsupportedFinalizedAssertions": {"type": "integer", "minimum": 0}, "hallucinatedFinalizedAssertions": {"type": "integer", "minimum": 0}, "errorCodes": {"type": "array", "uniqueItems": true, "items": {"enum": ["ENTITY_TYPE_MISMATCH", "ENTITY_SPAN_MISMATCH", "ENTITY_LABEL_MISMATCH", "ENTITY_MISSING", "ENTITY_EXTRA", "RELATION_PREDICATE_MISMATCH", "RELATION_ENDPOINT_MISMATCH", "RELATION_EVIDENCE_MISMATCH", "RELATION_MISSING", "RELATION_EXTRA", "ABSTENTION_MISSING", "ABSTENTION_OVER", "ABSTENTION_MODE_MISMATCH", "UNSUPPORTED_FINALIZED_ASSERTION", "HALLUCINATED_FINALIZED_ASSERTION"]}}, "entity": {"$ref": "#/$defs/itemMetric"}, "relation": {"$ref": "#/$defs/itemMetric"}}},
    "slice": {"type": "object", "additionalProperties": false, "required": ["caseCount", "classificationCounts", "semanticEditCount", "unsupportedFinalizedAssertions", "hallucinatedFinalizedAssertions", "abstentionRequired", "abstentionPredicted", "abstentionCorrect", "abstentionPrecision", "abstentionRecall", "entityMetrics", "relationMetrics"], "properties": {"caseCount": {"type": "integer", "minimum": 1}, "classificationCounts": {"$ref": "#/$defs/classificationCounts"}, "semanticEditCount": {"type": "integer", "minimum": 0}, "unsupportedFinalizedAssertions": {"type": "integer", "minimum": 0}, "hallucinatedFinalizedAssertions": {"type": "integer", "minimum": 0}, "abstentionRequired": {"type": "integer", "minimum": 0}, "abstentionPredicted": {"type": "integer", "minimum": 0}, "abstentionCorrect": {"type": "integer", "minimum": 0}, "abstentionPrecision": {"type": "number", "minimum": 0, "maximum": 1}, "abstentionRecall": {"type": "number", "minimum": 0, "maximum": 1}, "entityMetrics": {"$ref": "#/$defs/metric"}, "relationMetrics": {"$ref": "#/$defs/metric"}}},
    "worst": {"type": "object", "additionalProperties": false, "required": ["caseId", "classification", "semanticEditCount", "unsupportedFinalizedAssertions", "errorCodes"], "properties": {"caseId": {"pattern": "^dh-[0-9]{3}$"}, "classification": {"enum": ["unchanged", "minor", "major", "reject", "abstain"]}, "semanticEditCount": {"type": "integer", "minimum": 0}, "unsupportedFinalizedAssertions": {"type": "integer", "minimum": 0}, "errorCodes": {"type": "array", "uniqueItems": true, "items": {"enum": ["ENTITY_TYPE_MISMATCH", "ENTITY_SPAN_MISMATCH", "ENTITY_LABEL_MISMATCH", "ENTITY_MISSING", "ENTITY_EXTRA", "RELATION_PREDICATE_MISMATCH", "RELATION_ENDPOINT_MISMATCH", "RELATION_EVIDENCE_MISMATCH", "RELATION_MISSING", "RELATION_EXTRA", "ABSTENTION_MISSING", "ABSTENTION_OVER", "ABSTENTION_MODE_MISMATCH", "UNSUPPORTED_FINALIZED_ASSERTION", "HALLUCINATED_FINALIZED_ASSERTION"]}}}},
    "taxonomy": {"type": "object", "additionalProperties": false, "required": ["codes", "counts"], "properties": {"codes": {"const": ["ENTITY_TYPE_MISMATCH", "ENTITY_SPAN_MISMATCH", "ENTITY_LABEL_MISMATCH", "ENTITY_MISSING", "ENTITY_EXTRA", "RELATION_PREDICATE_MISMATCH", "RELATION_ENDPOINT_MISMATCH", "RELATION_EVIDENCE_MISMATCH", "RELATION_MISSING", "RELATION_EXTRA", "ABSTENTION_MISSING", "ABSTENTION_OVER", "ABSTENTION_MODE_MISMATCH", "UNSUPPORTED_FINALIZED_ASSERTION", "HALLUCINATED_FINALIZED_ASSERTION"]}, "counts": {"type": "object", "minProperties": 15, "additionalProperties": {"type": "integer", "minimum": 0}}}}
  }
}
