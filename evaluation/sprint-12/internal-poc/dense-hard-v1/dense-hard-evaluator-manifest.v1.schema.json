{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projecta.example/schemas/s12-dense-hard-evaluator-manifest.v1.json",
  "title": "Sprint 12 Dense-Hard Evaluator Manifest v1",
  "type": "object", "additionalProperties": false,
  "required": ["artifactVersion", "status", "datasetKind", "sourcePayloadPath", "sourcePayloadDigest", "goldPath", "goldDigest", "caseCount", "scenarioCount", "abstentionCaseCount", "sliceCounts", "records", "nonClaims", "manifestDigest"],
  "properties": {"artifactVersion": {"const": "s12.dense-hard.evaluator-manifest.v1"}, "status": {"const": "FROZEN_EVALUATOR_MANIFEST"}, "datasetKind": {"const": "SYNTHETIC_NON_PRODUCTION"}, "sourcePayloadPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v1/dense-hard-source-payload.v1.json"}, "sourcePayloadDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}, "goldPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v1/dense-hard-gold.v1.json"}, "goldDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}, "caseCount": {"const": 24}, "scenarioCount": {"const": 24}, "abstentionCaseCount": {"type": "integer", "minimum": 4}, "sliceCounts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}}, "records": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/record"}}, "nonClaims": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}, "manifestDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}},
  "$defs": {"record": {"type": "object", "additionalProperties": false, "required": ["caseId", "scenarioId", "language", "slices", "entityCount", "relationCount", "abstentionRequired"], "properties": {"caseId": {"pattern": "^dh-[0-9]{3}$"}, "scenarioId": {"pattern": "^dh-s-[0-9]{3}$"}, "language": {"enum": ["en", "vi", "ja", "mixed"]}, "slices": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "entityCount": {"type": "integer", "minimum": 1, "maximum": 10}, "relationCount": {"type": "integer", "minimum": 0, "maximum": 8}, "abstentionRequired": {"type": "boolean"}}}}
}
