{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projecta.example/schemas/s12-dense-hard-source-payload.v1.json",
  "title": "Sprint 12 Dense-Hard Source-Only Payload v1",
  "type": "object", "additionalProperties": false,
  "required": ["artifactVersion", "status", "datasetKind", "sourceOnly", "goldIncluded", "evaluatorManifestIncluded", "providerCalls", "heldOutInspection", "requiredOutputSchema", "records", "payloadDigest"],
  "properties": {"artifactVersion": {"const": "s12.dense-hard.source-payload.v1"}, "status": {"const": "FROZEN_SOURCE_ONLY_FOR_CANDIDATE"}, "datasetKind": {"const": "SYNTHETIC_NON_PRODUCTION"}, "sourceOnly": {"const": true}, "goldIncluded": {"const": false}, "evaluatorManifestIncluded": {"const": false}, "providerCalls": {"const": 0}, "heldOutInspection": {"const": false}, "requiredOutputSchema": {"$ref": "#/$defs/outputSchema"}, "records": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/record"}}, "payloadDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}},
  "$defs": {
    "outputSchema": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "entities", "relations", "abstention", "anchorRule"], "properties": {"schemaVersion": {"const": "dense-hard-output.v1"}, "entities": {"const": "entityId,type,label,evidence{startOffset,endOffset,text}"}, "relations": {"const": "relationId,predicate,sourceEntityId,targetEntityId,evidence"}, "abstention": {"const": "abstentionReason when unsupported, ambiguous, stale, negated, or cross-project content prevents finalization"}, "anchorRule": {"const": "zero-based Unicode code-point half-open offsets; exact evidence text"}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["caseId", "scenarioId", "language", "slices", "sourceDigest", "rawText"], "properties": {"caseId": {"pattern": "^dh-[0-9]{3}$"}, "scenarioId": {"pattern": "^dh-s-[0-9]{3}$"}, "language": {"enum": ["en", "vi", "ja", "mixed"]}, "slices": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "sourceDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}, "rawText": {"type": "string", "minLength": 1}}}
  }
}
