{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projecta.example/schemas/s12-dense-hard-candidate.v1.json",
  "title": "Sprint 12 Dense-Hard Frozen Source-Only Candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactVersion", "status", "candidateModel", "reasoning", "agentCandidateCalls", "providerCalls", "payloadPath", "payloadDigest", "projectScopeId", "records", "goldIncluded", "priorReviewsIncluded", "heldOutInspection", "rawSensitiveDataIncluded", "reviewOrScoringPerformed", "nonClaims", "codeDigest", "candidateDigest"],
  "properties": {
    "artifactVersion": {"const": "s12.dense-hard.candidate.v1"},
    "status": {"const": "CANDIDATE_FROZEN_SOURCE_ONLY"},
    "candidateModel": {"const": "gpt-5.6-luna"},
    "reasoning": {"const": "high"},
    "agentCandidateCalls": {"const": 24},
    "providerCalls": {"const": 0},
    "payloadPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v1/dense-hard-source-payload.v1.json"},
    "payloadDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "projectScopeId": {"const": "projecta.synthetic.s12.dense-hard"},
    "records": {"type": "array", "minItems": 24, "maxItems": 24, "items": {"$ref": "#/$defs/record"}},
    "goldIncluded": {"const": false},
    "priorReviewsIncluded": {"const": false},
    "heldOutInspection": {"const": false},
    "rawSensitiveDataIncluded": {"const": false},
    "reviewOrScoringPerformed": {"const": false},
    "nonClaims": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "codeDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "candidateDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["startOffset", "endOffset", "text"],
      "properties": {"startOffset": {"type": "integer", "minimum": 0}, "endOffset": {"type": "integer", "exclusiveMinimum": 0}, "text": {"type": "string", "minLength": 1}}
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["entityId", "type", "label", "evidence"],
      "properties": {
        "entityId": {"type": "string", "pattern": "^dh-[0-9]{3}-e[0-9]{2}$"},
        "type": {"enum": ["Requirement", "Decision", "Question", "Task", "Risk", "Assumption", "Constraint", "ProgressClaim", "ResearchFinding"]},
        "label": {"type": "string", "minLength": 1}, "evidence": {"$ref": "#/$defs/span"}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["relationId", "predicate", "sourceEntityId", "targetEntityId", "evidence"],
      "properties": {
        "relationId": {"type": "string", "pattern": "^dh-[0-9]{3}-r[0-9]{2}$"},
        "predicate": {"enum": ["implements", "blocks", "dependsOn", "supports", "answers", "resolves", "constrainedBy"]},
        "sourceEntityId": {"type": "string", "pattern": "^dh-[0-9]{3}-e[0-9]{2}$"},
        "targetEntityId": {"type": "string", "pattern": "^dh-[0-9]{3}-e[0-9]{2}$"}, "evidence": {"$ref": "#/$defs/span"}
      }
    },
    "abstention": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "abstentionReason", "withheldAssertions"],
      "properties": {
        "status": {"enum": ["none", "partial", "full"]},
        "abstentionReason": {"type": ["string", "null"]},
        "withheldAssertions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["schemaVersion", "projectScopeId", "entities", "relations", "abstention"],
      "properties": {
        "schemaVersion": {"const": "dense-hard-output.v1"}, "projectScopeId": {"const": "projecta.synthetic.s12.dense-hard"},
        "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}}, "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}}, "abstention": {"$ref": "#/$defs/abstention"}
      }
    },
    "sourceVersion": {
      "type": "object", "additionalProperties": false,
      "required": ["sourceVersionId", "projectScopeId", "canonicalContentDigest", "coordinateSystemVersion", "receiptDigest", "canonicalizationVersion", "contractVersion", "originalContentDigest", "parentCanonicalContentDigest", "parentSourceVersionId", "replayKey", "retention", "sourceArtifactScopeId"],
      "properties": {
        "sourceVersionId": {"type": "string"}, "projectScopeId": {"const": "projecta.synthetic.s12.dense-hard"}, "canonicalContentDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}, "coordinateSystemVersion": {"const": "unicode-code-point-half-open.v1"}, "receiptDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}, "canonicalizationVersion": {"const": "utf8-exact-source.v1"}, "contractVersion": {"const": "dense-hard-output.v1"}, "originalContentDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}, "parentCanonicalContentDigest": {"type": ["string", "null"]}, "parentSourceVersionId": {"type": ["string", "null"]}, "replayKey": {"type": "string"}, "retention": {"type": "object", "additionalProperties": false, "required": ["expiresOn", "policy"], "properties": {"expiresOn": {"type": ["string", "null"]}, "policy": {"const": "synthetic-source-only"}}}, "sourceArtifactScopeId": {"const": "projecta.synthetic.s12.dense-hard"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "scenarioId", "language", "sourceDigest", "sourceVersion", "response", "responseDigest"],
      "properties": {
        "caseId": {"pattern": "^dh-[0-9]{3}$"}, "scenarioId": {"pattern": "^dh-s-[0-9]{3}$"}, "language": {"enum": ["en", "vi", "ja", "mixed"]}, "sourceDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}, "sourceVersion": {"$ref": "#/$defs/sourceVersion"}, "response": {"$ref": "#/$defs/response"}, "responseDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
