{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projecta.example/schemas/s12-dense-hard-candidate.v2.json",
  "title": "Sprint 12 Dense-Hard Source-Only Candidate v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactVersion", "schemaVersion", "datasetKind", "status", "sourceOnly",
    "sourcePayloadPath", "sourcePayloadDigest", "protocolPath", "protocolDigest",
    "candidateModel", "reasoning", "agentCandidateCalls", "providerCalls",
    "goldIncluded", "priorReviewsIncluded", "scoring", "review", "codeDigest",
    "candidateDigest", "responses"
  ],
  "properties": {
    "artifactVersion": {"const": "s12.dense-hard.candidate.v2"},
    "schemaVersion": {"const": "dense-hard-output.v2"},
    "datasetKind": {"const": "SYNTHETIC_NON_PRODUCTION"},
    "status": {"const": "FROZEN_SOURCE_ONLY_CANDIDATE"},
    "sourceOnly": {"const": true},
    "sourcePayloadPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v2/dense-hard-source-payload.v2.json"},
    "sourcePayloadDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "protocolPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v2/dense-hard-source-only-protocol.v2.json"},
    "protocolDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "candidateModel": {"const": "gpt-5.6-luna"},
    "reasoning": {"const": "high"},
    "agentCandidateCalls": {"const": 28},
    "providerCalls": {"const": 0},
    "goldIncluded": {"const": false},
    "priorReviewsIncluded": {"const": false},
    "scoring": {"const": false},
    "review": {"const": false},
    "codeDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "candidateDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "responses": {
      "type": "array", "minItems": 28, "maxItems": 28,
      "items": {"$ref": "#/$defs/response"}
    }
  },
  "$defs": {
    "anchor": {
      "type": "object", "additionalProperties": false,
      "required": ["startOffset", "endOffset", "text"],
      "properties": {
        "startOffset": {"type": "integer", "minimum": 0},
        "endOffset": {"type": "integer", "minimum": 1},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["entityId", "occurrenceKey", "type", "label", "evidence"],
      "properties": {
        "entityId": {"type": "string", "pattern": "^ent-dh2-[0-9]{3}-[0-9]{2}$"},
        "occurrenceKey": {"type": "string", "pattern": "^dh2-[0-9]{3}:occ-[0-9]{2}$"},
        "type": {"enum": ["Task", "Requirement", "Constraint", "Risk", "System", "Project", "Document", "Question", "Decision", "Dataset", "Person", "Control", "Resource"]},
        "label": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/anchor"}
      }
    },
    "relation": {
      "type": "object", "additionalProperties": false,
      "required": ["relationId", "predicate", "sourceEntityId", "targetEntityId", "triggerEvidence", "evidence"],
      "properties": {
        "relationId": {"type": "string", "pattern": "^rel-dh2-[0-9]{3}-[0-9]{2}$"},
        "predicate": {"enum": ["dependsOn", "implements", "blocks", "supports", "validates", "tracks", "constrains", "supersedes", "requires", "answers", "contains"]},
        "sourceEntityId": {"type": "string", "pattern": "^ent-dh2-[0-9]{3}-[0-9]{2}$"},
        "targetEntityId": {"type": "string", "pattern": "^ent-dh2-[0-9]{3}-[0-9]{2}$"},
        "triggerEvidence": {"$ref": "#/$defs/anchor"},
        "evidence": {"$ref": "#/$defs/anchor"}
      }
    },
    "quarantine": {
      "type": "object", "additionalProperties": false,
      "required": ["assertionId", "kind", "reasonCode", "status", "evidence"],
      "properties": {
        "assertionId": {"type": "string", "pattern": "^q-dh2-[0-9]{3}-[0-9]{2}$"},
        "kind": {"enum": ["entity", "relation", "proposition"]},
        "reasonCode": {"enum": ["UNSUPPORTED_PREDICATE", "NEGATED", "AMBIGUOUS", "STALE", "CROSS_PROJECT", "ADVERSARIAL", "UNVERIFIED", "DISTRACTOR", "NON_ASSERTION"]},
        "status": {"const": "quarantined"},
        "evidence": {"$ref": "#/$defs/anchor"},
        "triggerEvidence": {"$ref": "#/$defs/anchor"}
      }
    },
    "proposition": {
      "type": "object", "additionalProperties": false,
      "required": ["assertionId", "kind", "status"],
      "properties": {
        "assertionId": {"type": "string"},
        "kind": {"enum": ["entity", "relation", "proposition"]},
        "status": {"enum": ["finalized", "quarantined"]},
        "entityId": {"type": "string"},
        "relationId": {"type": "string"}
      }
    },
    "occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["occurrenceKey", "entityId", "label", "evidence"],
      "properties": {
        "occurrenceKey": {"type": "string"},
        "entityId": {"type": "string"},
        "label": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/anchor"}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "scenarioId", "language", "sourceDigest", "abstention", "entities", "relations", "quarantined", "occurrenceRegistry", "propositionRegistry"],
      "properties": {
        "caseId": {"pattern": "^dh2-[0-9]{3}$"},
        "scenarioId": {"pattern": "^dh2-s-[0-9]{3}$"},
        "language": {"enum": ["en", "vi", "ja", "mixed"]},
        "sourceDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "abstention": {
          "type": "object", "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": {"enum": ["none", "partial", "full"]},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
        "quarantined": {"type": "array", "items": {"$ref": "#/$defs/quarantine"}},
        "occurrenceRegistry": {"type": "array", "items": {"$ref": "#/$defs/occurrence"}},
        "propositionRegistry": {"type": "array", "items": {"$ref": "#/$defs/proposition"}}
      }
    }
  }
}
