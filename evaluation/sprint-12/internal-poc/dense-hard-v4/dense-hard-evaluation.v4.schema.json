{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://projecta.example/schemas/s12-dense-hard-evaluation.v4.json",
  "title": "Sprint 12 Dense-Hard v4 Stratified Evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactVersion", "status", "datasetKind", "evaluatorVersion", "sourcePayloadPath", "sourcePayloadDigest", "protocolPath", "protocolDigest", "contractPath", "contractDigest", "goldPath", "goldDigest", "manifestPath", "manifestDigest", "candidatePath", "candidateDigest", "candidateModel", "providerCalls", "antiLeakChecks", "counts", "perItemClassificationCounts", "semanticEditCounts", "typeDiagnostics", "entityMetrics", "relationMetrics", "utilityGate", "safetyGate", "overallPass", "pooledLegacyDiagnostic", "v3_1Comparison", "perItem", "perSlice", "difficultyTiers", "worstCases", "errorTaxonomy", "nonClaims", "evaluationDigest"],
  "properties": {
    "artifactVersion": {"const": "s12.dense-hard.evaluation.v4"},
    "status": {"const": "EVALUATED_FROZEN_CANDIDATE_STRATIFIED"},
    "datasetKind": {"const": "SYNTHETIC_NON_PRODUCTION"},
    "evaluatorVersion": {"const": "s12.dense-hard.evaluator.v4"},
    "sourcePayloadPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v4/dense-hard-source-payload.v4.json"},
    "sourcePayloadDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "protocolPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v4/dense-hard-source-only-protocol.v4.json"},
    "protocolDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "contractPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v4/dense-hard-evaluator-contract.v4.json"},
    "contractDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "goldPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v4/dense-hard-gold.v4.json"},
    "goldDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "manifestPath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v4/dense-hard-evaluator-manifest.v4.json"},
    "manifestDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
    "candidatePath": {"const": "evaluation/sprint-12/internal-poc/dense-hard-v4/dense-hard-candidate.v4.json"},
    "candidateDigest": {"const": "sha256:c1a3618eec4cfb0657c738b3dff6233a011a0ff7ae1bbe661b7a21490c4e4e35"},
    "candidateModel": {"type": "object", "additionalProperties": false, "required": ["id", "reasoningEffort", "calls"], "properties": {"id": {"const": "gpt-5.6-luna"}, "reasoningEffort": {"const": "high"}, "calls": {"const": 32}}},
    "providerCalls": {"const": 0},
    "antiLeakChecks": {"type": "object", "minProperties": 10, "additionalProperties": {"const": true}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["caseCount", "utilityCaseCount", "safetyCaseCount", "entityGold", "entityCandidate", "relationGold", "relationCandidate", "quarantinePredicted"], "properties": {"caseCount": {"const": 32}, "utilityCaseCount": {"const": 24}, "safetyCaseCount": {"const": 8}, "entityGold": {"type": "integer", "minimum": 0}, "entityCandidate": {"type": "integer", "minimum": 0}, "relationGold": {"type": "integer", "minimum": 0}, "relationCandidate": {"type": "integer", "minimum": 0}, "quarantinePredicted": {"type": "integer", "minimum": 0}}},
    "perItemClassificationCounts": {"$ref": "#/$defs/counts"},
    "semanticEditCounts": {"$ref": "#/$defs/edits"},
    "typeDiagnostics": {"type": "object", "additionalProperties": false, "required": ["typeCorrections", "identityIndependentOfType", "cascadeToRelation", "ambiguousExcludedFromPassFail"], "properties": {"typeCorrections": {"type": "integer", "minimum": 0}, "identityIndependentOfType": {"const": true}, "cascadeToRelation": {"const": false}, "ambiguousExcludedFromPassFail": {"const": true}}},
    "entityMetrics": {"$ref": "#/$defs/metric"}, "relationMetrics": {"$ref": "#/$defs/metric"},
    "utilityGate": {"$ref": "#/$defs/gate"}, "safetyGate": {"type": "object", "additionalProperties": true}, "overallPass": {"type": "boolean"},
    "pooledLegacyDiagnostic": {"type": "object", "additionalProperties": true, "required": ["authoritative"], "properties": {"authoritative": {"const": false}}},
    "v3_1Comparison": {"type": "object", "additionalProperties": true, "required": ["pooled", "adjudicationDigest"], "properties": {"pooled": {"const": false}, "adjudicationDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}}},
    "perItem": {"type": "array", "minItems": 32, "maxItems": 32, "items": {"type": "object", "additionalProperties": true, "required": ["caseId", "classification", "semanticEditCount", "unsupportedFinalizedAssertions"]}},
    "perSlice": {"type": "object", "additionalProperties": {"type": "object"}}, "difficultyTiers": {"type": "object", "additionalProperties": {"type": "object"}}, "worstCases": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": true}},
    "errorTaxonomy": {"type": "object", "additionalProperties": true, "required": ["codes", "counts"]}, "nonClaims": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}, "evaluationDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "counts": {"type": "object", "additionalProperties": false, "required": ["unchanged", "minor", "major", "reject", "abstain"], "properties": {"unchanged": {"type": "integer", "minimum": 0}, "minor": {"type": "integer", "minimum": 0}, "major": {"type": "integer", "minimum": 0}, "reject": {"type": "integer", "minimum": 0}, "abstain": {"type": "integer", "minimum": 0}}},
    "edits": {"type": "object", "additionalProperties": false, "required": ["total", "meanPerCase"], "properties": {"total": {"type": "integer", "minimum": 0}, "meanPerCase": {"type": "number", "minimum": 0}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["tp", "fp", "fn", "precision", "recall", "f1"], "properties": {"tp": {"type": "integer", "minimum": 0}, "fp": {"type": "integer", "minimum": 0}, "fn": {"type": "integer", "minimum": 0}, "precision": {"type": "number", "minimum": 0, "maximum": 1}, "recall": {"type": "number", "minimum": 0, "maximum": 1}, "f1": {"type": "number", "minimum": 0, "maximum": 1}}},
    "gate": {"type": "object", "additionalProperties": true, "required": ["pass"], "properties": {"pass": {"type": "boolean"}}}
  }
}
