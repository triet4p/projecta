{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Dense-Hard v4 Frozen Source-Only Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactVersion", "status", "datasetKind", "sourceOnly", "model", "providerCalls", "bindings", "records", "nonClaims", "candidateDigest"],
  "properties": {
    "artifactVersion": {"const": "s12.dense-hard.candidate.v4"},
    "status": {"const": "FROZEN_SOURCE_ONLY_CANDIDATE"},
    "datasetKind": {"const": "SYNTHETIC_NON_PRODUCTION"},
    "sourceOnly": {"const": true},
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "reasoningEffort", "calls"],
      "properties": {
        "id": {"const": "gpt-5.6-luna"},
        "reasoningEffort": {"const": "high"},
        "calls": {"const": 32}
      }
    },
    "providerCalls": {"const": 0},
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePayloadDigest", "protocolDigest", "evaluatorContractDigest", "goldDigest", "manifestDigest"],
      "properties": {
        "sourcePayloadDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "protocolDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "evaluatorContractDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
        "goldDigest": {"type": "null"},
        "manifestDigest": {"type": "null"}
      }
    },
    "records": {
      "type": "array", "minItems": 32, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["caseId", "scenarioId", "sourceDigest", "entities", "relations", "abstention", "quarantine", "uncertainty"],
        "properties": {
          "caseId": {"pattern": "^dh4-[0-9]{3}$"},
          "scenarioId": {"pattern": "^dh4-s-[0-9]{3}$"},
          "sourceDigest": {"pattern": "^sha256:[0-9a-f]{64}$"},
          "entities": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["occurrenceId", "type", "label", "evidence"],
              "properties": {
                "occurrenceId": {"pattern": "^dh4-[0-9]{3}-e[0-9]{2}$"},
                "type": {"enum": ["Task", "Requirement", "Constraint", "Risk", "System", "Project", "Document", "Question", "Decision", "Dataset", "Person", "Control", "Resource"]},
                "label": {"type": "string", "minLength": 1},
                "evidence": {"$ref": "#/$defs/span"}
              }
            }
          },
          "relations": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["predicate", "sourceOccurrenceId", "targetOccurrenceId", "triggerEvidence"],
              "properties": {
                "predicate": {"enum": ["dependsOn", "implements", "blocks", "supports", "validates", "tracks", "constrains", "supersedes", "requires", "answers", "contains"]},
                "sourceOccurrenceId": {"pattern": "^dh4-[0-9]{3}-e[0-9]{2}$"},
                "targetOccurrenceId": {"pattern": "^dh4-[0-9]{3}-e[0-9]{2}$"},
                "triggerEvidence": {"$ref": "#/$defs/span"}
              }
            }
          },
          "abstention": {"enum": ["none", "partial", "full"]},
          "quarantine": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["reason", "evidence"],
              "properties": {
                "reason": {"type": "string", "minLength": 1},
                "evidence": {"$ref": "#/$defs/span"},
                "triggerEvidence": {"$ref": "#/$defs/span"}
              }
            }
          },
          "uncertainty": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "nonClaims": {"type": "array", "items": {"type": "string"}},
    "candidateDigest": {"pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "span": {
      "type": "object", "additionalProperties": false,
      "required": ["startOffset", "endOffset", "text"],
      "properties": {
        "startOffset": {"type": "integer", "minimum": 0},
        "endOffset": {"type": "integer", "exclusiveMinimum": 0},
        "text": {"type": "string", "minLength": 1}
      }
    }
  }
}
