{
  "name": "projecta-web",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:nginx-config": "node scripts/check-nginx-config.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "generate:api": "node scripts/generate-api-client.mjs",
    "check:api-drift": "node scripts/generate-api-client.mjs --check && uv run --project ../api python scripts/check-api-contract.py"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.35.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
